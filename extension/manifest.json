{
  "manifest_version": 3,
  "name": "Hustle — Moodle",
  "version": "1.1.0",
  "description": "Курси Moodle у твоєму навчальному просторі Hustle.",
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://learn.ucu.edu.ua/*",
    "https://e-learning.lnu.edu.ua/*",
    "https://vns.lpnu.ua/*",
    "https://dl.nure.ua/*",
    "https://do.ipo.kpi.ua/*",
    "https://moodle.vntu.edu.ua/*",
    "https://school.moodledemo.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hustle — підключити курс"
  },
  "content_scripts": [
    {
      "matches": [
        "https://learn.ucu.edu.ua/*",
        "https://e-learning.lnu.edu.ua/*",
        "https://vns.lpnu.ua/*",
        "https://dl.nure.ua/*",
        "https://do.ipo.kpi.ua/*",
        "https://moodle.vntu.edu.ua/*",
        "https://school.moodledemo.net/*"
      ],
      "include_globs": [
        "*/course/view.php*"
      ],
      "js": [
        "extractor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:8000/hustle/*",
        "http://localhost:8000/hustle/*"
      ],
      "js": [
        "hustle-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
