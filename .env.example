# Moodle Platform Configuration
MOODLE_BASE_URL=https://learn.ucu.edu.ua
MOODLE_SERVICE_SHORTNAME=moodle_mobile_app
MOODLE_MOCK_MODE=false
MOODLE_REQUEST_TIMEOUT=20.0

# Security & Session Settings
SECRET_KEY=ucu-moodle-connector-jwt-secret-key-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cookie settings
COOKIE_NAME=moodle_session
PLATFORM_COOKIE_NAME=platform_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth (Website Account Login -> pairs MoodleSession without passwords)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
AUTH_DEV_GOOGLE_ENABLED=false

# Per-Person Temporary Staging Storage (OBD)
TEMP_STORAGE_DIR=data/staging
TEMP_STORAGE_TTL_SECONDS=3600
TEMP_STORAGE_AUTO_PURGE=true
S3_BUCKET=
S3_REGION=eu-central-1
S3_PREFIX=staging
